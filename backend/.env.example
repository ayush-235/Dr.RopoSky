# Google Gemini API Configuration (Optional for static analysis, required for AI enrichment)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend Service Configuration
ROKOSPY_BACKEND_HOST=0.0.0.0
ROKOSPY_BACKEND_PORT=8000
ROKOSPY_BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dr-roposky.vercel.app

# Supabase PostgreSQL Persistence (Optional — defaults to memory store if omitted)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
