# ==============================================================================
# Dr.RopoSky — Environment Configuration Template
# ==============================================================================

# Google Gemini API Configuration (Required for AI explanations and suggested diffs)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend Service Configuration
ROKOSPY_BACKEND_HOST=0.0.0.0
ROKOSPY_BACKEND_PORT=8000
ROKOSPY_BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase PostgreSQL Persistence (Optional — defaults to memory store if omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
